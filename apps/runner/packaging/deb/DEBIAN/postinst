#!/bin/bash
set -e

# Create necessary directories
mkdir -p /var/lib/northrays/runner
mkdir -p /var/log/northrays
mkdir -p /etc/northrays

# Create default environment file if it doesn't exist
if [ ! -f /etc/northrays/runner.env ]; then
    cat > /etc/northrays/runner.env <<EOF
# Northrays Runner Environment Variables
# Add your configuration here, for example:
# NORTHRAYS_API_URL=https://api.northrays.com
# NORTHRAYS_RUNNER_TOKEN=your-token-here
EOF
    chmod 600 /etc/northrays/runner.env
fi

# Reload systemd daemon
systemctl daemon-reload

echo "Northrays Runner installed successfully"
echo ""
echo "Next steps:"
echo "1. Configure environment variables in /etc/northrays/runner.env"
echo "2. Enable and start the service: systemctl enable --now northrays-runner"
echo ""
echo "To check service status: systemctl status northrays-runner"

exit 0
