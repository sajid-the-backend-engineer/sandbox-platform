[Unit]
Description=Northrays Runner Service
Documentation=https://github.com/northrays/sandbox-platform
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/lib/northrays/runner

# Binary location
ExecStart=/opt/northrays/runner

# Environment file for configuration
EnvironmentFile=-/etc/northrays/runner.env

# Restart policy
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/northrays/runner /var/log/northrays /etc/iptables /tmp

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=northrays-runner

[Install]
WantedBy=multi-user.target
