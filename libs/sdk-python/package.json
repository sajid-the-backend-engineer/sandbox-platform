    "docs:async-lsp": "FIRST_SECTION='AsyncLspServer' OUTPUT_FILE=\"$npm_package_config_docsDir/async/async-lsp-server.mdx\" pydoc-markdown -m northrays._async.lsp_server -m northrays.common.lsp_server pydoc-markdown.yml",
    "docs:async-volume": "FIRST_SECTION='Volume' OUTPUT_FILE=\"$npm_package_config_docsDir/async/async-volume.mdx\" pydoc-markdown -m northrays._async.volume -m northrays.common.volume pydoc-markdown.yml",
    "docs:async-object_storage": "FIRST_SECTION='AsyncObjectStorage' OUTPUT_FILE=\"$npm_package_config_docsDir/async/async-object-storage.mdx\" pydoc-markdown -m northrays._async.object_storage pydoc-markdown.yml",
    "docs:async-snapshot": "FIRST_SECTION='Snapshot' OUTPUT_FILE=\"$npm_package_config_docsDir/async/async-snapshot.mdx\" pydoc-markdown -m northrays._async.snapshot -m northrays.common.snapshot pydoc-markdown.yml",
    "docs:async-computer_use": "FIRST_SECTION='AsyncComputerUse' OUTPUT_FILE=\"$npm_package_config_docsDir/async/async-computer-use.mdx\" pydoc-markdown -m northrays._async.computer_use -m northrays.common.computer_use pydoc-markdown.yml",
    "docs:async-code_interpreter": "FIRST_SECTION='AsyncCodeInterpreter' OUTPUT_FILE=\"$npm_package_config_docsDir/async/async-code-interpreter.mdx\" pydoc-markdown -m northrays._async.code_interpreter -m northrays.common.code_interpreter pydoc-markdown.yml"
  }
}
