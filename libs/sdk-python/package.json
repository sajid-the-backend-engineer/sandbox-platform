{
  "version": "0.0.0-dev",
  "config": {
    "docsDir": "../../apps/docs/src/content/docs/en/python-sdk"
  },
  "scripts": {
    "build": "python -m build",
    "docs": "bash -O extglob -c 'rm -rf $npm_package_config_docsDir/!(index.mdx)' && npm run docs:common && npm run docs:sync && npm run docs:async",
    "docs:common": "bash -O extglob -c 'rm -rf $npm_package_config_docsDir/common' && npm run docs:errors && npm run docs:charts && npm run docs:image",
    "docs:sync": "bash -O extglob -c 'rm -rf $npm_package_config_docsDir/sync' && npm run docs:northrays && npm run docs:sandbox && npm run docs:filesystem && npm run docs:git && npm run docs:process && npm run docs:lsp && npm run docs:volume && npm run docs:object_storage && npm run docs:snapshot && npm run docs:computer_use && npm run docs:code_interpreter",
    "docs:async": "bash -O extglob -c 'rm -rf $npm_package_config_docsDir/async' && npm run docs:async-northrays && npm run docs:async-sandbox && npm run docs:async-filesystem && npm run docs:async-git && npm run docs:async-process && npm run docs:async-lsp && npm run docs:async-volume && npm run docs:async-object_storage && npm run docs:async-snapshot && npm run docs:async-computer_use && npm run docs:async-code_interpreter",
    "docs:errors": "FIRST_SECTION='NorthraysError' OUTPUT_FILE=\"$npm_package_config_docsDir/common/errors.mdx\" pydoc-markdown -m northrays.common.errors pydoc-markdown.yml",
    "docs:charts": "FIRST_SECTION='Chart' OUTPUT_FILE=\"$npm_package_config_docsDir/common/charts.mdx\" pydoc-markdown -m northrays.common.charts pydoc-markdown.yml",
    "docs:image": "FIRST_SECTION='Image' OUTPUT_FILE=\"$npm_package_config_docsDir/common/image.mdx\" pydoc-markdown -m northrays.common.image pydoc-markdown.yml",
    "docs:northrays": "FIRST_SECTION='Northrays' OUTPUT_FILE=\"$npm_package_config_docsDir/sync/northrays.mdx\" pydoc-markdown -m northrays._sync.northrays -m northrays.common.northrays pydoc-markdown.yml",
    "docs:sandbox": "FIRST_SECTION='Sandbox' OUTPUT_FILE=\"$npm_package_config_docsDir/sync/sandbox.mdx\" pydoc-markdown -m northrays._sync.sandbox -m northrays.common.sandbox pydoc-markdown.yml",
    "docs:filesystem": "FIRST_SECTION='FileSystem' OUTPUT_FILE=\"$npm_package_config_docsDir/sync/file-system.mdx\" pydoc-markdown -m northrays._sync.filesystem -m northrays.common.filesystem pydoc-markdown.yml",
    "docs:git": "FIRST_SECTION='Git' OUTPUT_FILE=\"$npm_package_config_docsDir/sync/git.mdx\" pydoc-markdown -m northrays._sync.git -m northrays.common.git pydoc-markdown.yml",
    "docs:process": "FIRST_SECTION='Process' OUTPUT_FILE=\"$npm_package_config_docsDir/sync/process.mdx\" pydoc-markdown -m northrays._sync.process -m northrays.common.process pydoc-markdown.yml",
    "docs:lsp": "FIRST_SECTION='LspServer' OUTPUT_FILE=\"$npm_package_config_docsDir/sync/lsp-server.mdx\" pydoc-markdown -m northrays._sync.lsp_server -m northrays.common.lsp_server pydoc-markdown.yml",
    "docs:volume": "FIRST_SECTION='Volume' OUTPUT_FILE=\"$npm_package_config_docsDir/sync/volume.mdx\" pydoc-markdown -m northrays._sync.volume -m northrays.common.volume pydoc-markdown.yml",
    "docs:object_storage": "FIRST_SECTION='ObjectStorage' OUTPUT_FILE=\"$npm_package_config_docsDir/sync/object-storage.mdx\" pydoc-markdown -m northrays._sync.object_storage pydoc-markdown.yml",
    "docs:snapshot": "FIRST_SECTION='Snapshot' OUTPUT_FILE=\"$npm_package_config_docsDir/sync/snapshot.mdx\" pydoc-markdown -m northrays._sync.snapshot -m northrays.common.snapshot pydoc-markdown.yml",
    "docs:computer_use": "FIRST_SECTION='ComputerUse' OUTPUT_FILE=\"$npm_package_config_docsDir/sync/computer-use.mdx\" pydoc-markdown -m northrays._sync.computer_use -m northrays.common.computer_use pydoc-markdown.yml",
    "docs:code_interpreter": "FIRST_SECTION='CodeInterpreter' OUTPUT_FILE=\"$npm_package_config_docsDir/sync/code-interpreter.mdx\" pydoc-markdown -m northrays._sync.code_interpreter -m northrays.common.code_interpreter pydoc-markdown.yml",
    "docs:async-northrays": "FIRST_SECTION='AsyncNorthrays' OUTPUT_FILE=\"$npm_package_config_docsDir/async/async-northrays.mdx\" pydoc-markdown -m northrays._async.northrays -m northrays.common.northrays pydoc-markdown.yml",
    "docs:async-sandbox": "FIRST_SECTION='AsyncSandbox' OUTPUT_FILE=\"$npm_package_config_docsDir/async/async-sandbox.mdx\" pydoc-markdown -m northrays._async.sandbox -m northrays.common.sandbox pydoc-markdown.yml",
    "docs:async-filesystem": "FIRST_SECTION='AsyncFileSystem' OUTPUT_FILE=\"$npm_package_config_docsDir/async/async-file-system.mdx\" pydoc-markdown -m northrays._async.filesystem -m northrays.common.filesystem pydoc-markdown.yml",
    "docs:async-git": "FIRST_SECTION='AsyncGit' OUTPUT_FILE=\"$npm_package_config_docsDir/async/async-git.mdx\" pydoc-markdown -m northrays._async.git -m northrays.common.git pydoc-markdown.yml",
